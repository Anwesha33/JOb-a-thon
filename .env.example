# Copy to .env and fill in. Never commit your real .env.

# --- Adzuna jobs API (free: https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country for the search (in, gb, us, ...)
ADZUNA_COUNTRY=in

# --- Answer generation (optional) ---
# If set, application questions are answered with the Claude API.
# If empty, the tool falls back to resume-derived templates.
ANTHROPIC_API_KEY=

# --- App ---
# Max new companies discovery may look at per calendar day.
DAILY_COMPANY_LIMIT=10
# Only surface postings created within this many days.
FRESHNESS_DAYS=30
